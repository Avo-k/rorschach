# lichess-bot config tuned for the Docker image.
# Copy to ./config.yml at the repo root; compose mounts it read-only.

token: "REPLACE_WITH_YOUR_BOT_TOKEN"   # OAuth token of the BOT account
url: "https://lichess.org/"

engine:
  dir: "/opt/rorschach"
  name: ".venv/bin/rorschach-uci"
  protocol: "uci"
  ponder: false
  silence_stderr: false                 # keep [rorschach] logs visible

  uci_options:
    Profile: balanced                   # balanced | aggressive
    TimeMs: 0                           # 0 = derive from clock; else fixed ms per move
    Elo: 1900                           # Maia target Elo
    MaiaType: maia3-5m                  # maia3-5m | maia3-23m | maia3-79m | blitz | rapid

challenge:
  concurrency: 1
  accept_bot: true
  only_bot: false
  max_increment: 30
  min_increment: 0
  max_base: 600
  min_base: 60
  variants:
    - standard
  time_controls:
    - blitz
    - rapid
  modes:
    - casual
    - rated
