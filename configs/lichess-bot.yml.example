# Example config.yml for lichess-bot wrapping Rorschach.
# Copy into your lichess-bot/ directory and edit token + paths.

token: "REPLACE_WITH_YOUR_BOT_TOKEN"   # OAuth token of the BOT account
url: "https://lichess.org/"

engine:
  dir: "/home/avok/code/rorschach"     # working dir; Rorschach loads .env from here
  # Absolute path to the rorschach-uci entry point installed in our venv.
  # `uv sync` creates this; verify with `ls .venv/bin/rorschach-uci`.
  name: ".venv/bin/rorschach-uci"
  protocol: "uci"
  ponder: false
  silence_stderr: false                 # keep our [rorschach] logs visible

  uci_options:
    Profile: balanced                   # balanced | aggressive
    TimeMs: 0                           # 0 = derive from clock; else fixed ms per move
    Elo: 0                              # 0 = auto: look weird to the opponent's own rating (600..2600 pins a fixed bucket)
    MaiaType: maia3-5m                  # maia3-5m | maia3-23m | maia3-79m

challenge:
  concurrency: 1
  accept_bot: true
  only_bot: false
  max_increment: 30
  min_increment: 0
  max_base: 600                         # in seconds; cap at 10-min games for now
  min_base: 60
  variants:
    - standard
  time_controls:
    - blitz
    - rapid
  modes:
    - casual
    - rated

greeting:
  hello: "Hi! I play weird-but-sound moves. Default mode: balanced — type !bal or !agg to switch. Say 'verbose' and I'll narrate what I see."
  goodbye: "gg"
  hello_spectators: "Rorschach: weird-but-sound moves. Modes: !bal !agg."
  goodbye_spectators: "gg"
