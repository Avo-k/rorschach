.git/
.venv/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc

# Secrets — never bake into the image.
.env
.env.local

# Large data dirs — mount as volumes instead.
data/

# Local-only.
.vscode/
.idea/
*.swp
tests/
